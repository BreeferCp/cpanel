driver = sqlite
connect = /var/lib/breefercp/breefercp.db
default_pass_scheme = ARGON2ID

password_query = SELECT m.address AS user, m.password_hash AS password FROM mailboxes m JOIN accounts a ON a.id = m.account_id WHERE m.address = '%u' AND m.active = 1 AND a.status = 'active'

# Mail is stored in the owning account's home and runs as that account's uid,
# so one customer's mail process can never read another's mailbox.
user_query = SELECT a.sys_uid AS uid, a.sys_uid AS gid, \
  a.home_dir || '/mail/' || d.name || '/' || m.local_part AS home, \
  '*:storage=' || m.quota_mb || 'M' AS quota_rule \
  FROM mailboxes m JOIN accounts a ON a.id = m.account_id JOIN domains d ON d.id = m.domain_id \
  WHERE m.address = '%u' AND m.active = 1 AND a.status = 'active'

iterate_query = SELECT address AS user FROM mailboxes WHERE active = 1
